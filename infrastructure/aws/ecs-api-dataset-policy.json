{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DatasetObjectWriteAndVerify",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::REPLACE_DATASET_BUCKET/datasets/*"
    },
    {
      "Sid": "DatasetBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::REPLACE_DATASET_BUCKET"
    },
    {
      "Sid": "DatasetKmsEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": "REPLACE_KMS_KEY_ARN",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "s3.REPLACE_REGION.amazonaws.com"
        }
      }
    }
  ]
}
