{
  "version": 1,
  "naming": "speroflow/{environment}/{name}",
  "description": "Canonical Docker secret file names for SperoFlow main + knowledge stacks.",
  "secrets": [
    { "name": "postgres_password", "kind": "password", "stacks": ["main"], "notes": "Main app PostgreSQL" },
    { "name": "redis_password", "kind": "password", "stacks": ["main"] },
    { "name": "neo4j_password", "kind": "password", "stacks": ["main"] },
    { "name": "minio_access_key", "kind": "access_key", "stacks": ["main"] },
    { "name": "minio_secret_key", "kind": "access_key", "stacks": ["main"] },
    { "name": "admin_bootstrap_token", "kind": "token", "stacks": ["main"] },
    { "name": "smtp_password", "kind": "password", "stacks": ["main"], "optional": true },
    { "name": "bedrock_api_key", "kind": "token", "stacks": ["main"], "optional": true, "notes": "Prefer IAM role for Bedrock; use only if static API key required" },
    { "name": "service_jwt_private_key", "kind": "rsa", "stacks": ["main"], "encoding": "text" },
    { "name": "service_jwt_public_key", "kind": "rsa", "stacks": ["main", "knowledge"], "encoding": "text" },
    { "name": "oidc_signing_certificate", "kind": "pfx", "stacks": ["main"], "encoding": "binary" },
    { "name": "oidc_signing_certificate_password", "kind": "password", "stacks": ["main"] },
    { "name": "oidc_encryption_certificate", "kind": "pfx", "stacks": ["main"], "encoding": "binary" },
    { "name": "oidc_encryption_certificate_password", "kind": "password", "stacks": ["main"] },
    { "name": "knowledge_postgres_password", "kind": "password", "stacks": ["knowledge"] },
    { "name": "knowledge_redis_password", "kind": "password", "stacks": ["knowledge"] },
    { "name": "knowledge_neo4j_password", "kind": "password", "stacks": ["knowledge"] },
    { "name": "knowledge_neo4j_reader_password", "kind": "password", "stacks": ["main", "knowledge"], "notes": "Mounted on main ai-api only among main services" },
    { "name": "knowledge_neo4j_writer_password", "kind": "password", "stacks": ["knowledge"], "notes": "knowledge-worker only" },
    { "name": "knowledge_minio_access_key", "kind": "access_key", "stacks": ["knowledge"] },
    { "name": "knowledge_minio_secret_key", "kind": "access_key", "stacks": ["knowledge"] },
    { "name": "knowledge_service_jwt_private_key", "kind": "rsa", "stacks": ["knowledge"], "encoding": "text" },
    { "name": "knowledge_service_jwt_public_key", "kind": "rsa", "stacks": ["knowledge"], "encoding": "text" },
    { "name": "knowledge_grant_private_key", "kind": "rsa", "stacks": ["knowledge"], "encoding": "text" },
    { "name": "knowledge_grant_public_key", "kind": "rsa", "stacks": ["main", "knowledge"], "encoding": "text" },
    { "name": "knowledge_portal_data_protection_certificate", "kind": "pfx", "stacks": ["knowledge"], "encoding": "binary" },
    { "name": "knowledge_portal_data_protection_certificate_password", "kind": "password", "stacks": ["knowledge"] }
  ],
  "ssm_non_secret_examples": [
    { "name": "/speroflow/{environment}/config/app_domain", "type": "String" },
    { "name": "/speroflow/{environment}/config/knowledge_domain", "type": "String" },
    { "name": "/speroflow/{environment}/config/bedrock_model_id", "type": "String" }
  ]
}
