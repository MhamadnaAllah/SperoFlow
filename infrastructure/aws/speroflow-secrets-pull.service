[Unit]
Description=SperoFlow materialize secrets from AWS Secrets Manager
Documentation=file:///opt/speroflow/infrastructure/MANAGED_SECRETS.md
After=network-online.target
Wants=network-online.target
Before=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/speroflow
# Host-local overrides (create on the instance; do not commit real values that are secrets):
#   /etc/speroflow/secrets-pull.env
#   AWS_REGION=us-east-1
#   SPEROFLOW_SECRETS_ENV=prod
EnvironmentFile=-/etc/speroflow/secrets-pull.env
Environment=AWS_REGION=us-east-1
Environment=SPEROFLOW_SECRETS_ENV=prod
# Bash pull works on Amazon Linux without PowerShell.
ExecStart=/usr/local/bin/speroflow-secrets-pull
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
