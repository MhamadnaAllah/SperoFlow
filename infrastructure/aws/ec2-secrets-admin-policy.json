{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageSperoFlowEnvironmentSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue",
        "secretsmanager:TagResource",
        "secretsmanager:ListSecrets"
      ],
      "Resource": [
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:speroflow/REPLACE_ENV/*",
        "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:speroflow/REPLACE_ENV/*-*"
      ]
    },
    {
      "Sid": "EncryptDecryptSperoFlowSecretsKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "REPLACE_KMS_KEY_ARN",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REPLACE_REGION.amazonaws.com"
        }
      }
    }
  ]
}
