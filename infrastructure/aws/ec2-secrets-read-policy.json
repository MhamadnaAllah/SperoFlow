{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListSperoFlowSecretsInEnvironment",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSperoFlowEnvironmentSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:REPLACE_REGION:REPLACE_ACCOUNT_ID:secret:speroflow/REPLACE_ENV/*"
    },
    {
      "Sid": "DecryptWithSperoFlowSecretsKmsKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": "REPLACE_KMS_KEY_ARN",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.REPLACE_REGION.amazonaws.com"
        }
      }
    }
  ]
}
