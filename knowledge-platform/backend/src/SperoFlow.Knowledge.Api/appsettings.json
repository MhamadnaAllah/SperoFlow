{
  "KnowledgeDatabase": {
    "ConnectionString": "Host=knowledge-postgres;Port=5432;Database=speroflow_knowledge;Username=speroflow_knowledge;Password=change-me"
  },
  "KnowledgeStorage": {
    "BucketName": "speroflow-knowledge",
    "Region": "us-east-1",
    "Endpoint": "http://knowledge-object-storage:9000",
    "PublicEndpoint": "https://knowledge.example.com",
    "AccessKey": "change-me",
    "SecretKey": "change-me",
    "UseSsl": false,
    "PublicUseSsl": true
  },
  "KnowledgeRedis": {
    "ConnectionString": "knowledge-redis:6379,password=change-me,abortConnect=false",
    "JobsStream": "speroflow:knowledge:jobs"
  },
  "KnowledgeInternalAuth": {
    "MainIssuer": "speroflow-api",
    "MainAudience": "speroflow-knowledge",
    "MainPublicKeyPath": "/run/secrets/service_jwt_public_key",
    "WorkerIssuer": "speroflow-knowledge-api",
    "WorkerAudience": "speroflow-knowledge-api",
    "WorkerPrivateKeyPath": "/run/secrets/knowledge_service_jwt_private_key",
    "WorkerPublicKeyPath": "/run/secrets/knowledge_service_jwt_public_key",
    "WorkerDeliveryTokenLifetimeMinutes": 30,
    "WorkerLeaseDurationMinutes": 15
  },
  "KnowledgeGrants": {
    "Issuer": "speroflow-knowledge-api",
    "Audience": "speroflow-ai",
    "KeyId": "speroflow-knowledge-grant-1",
    "PrivateKeyPath": "/run/secrets/knowledge_grant_private_key",
    "PublicKeyPath": "/run/secrets/knowledge_grant_public_key"
  },
  "KnowledgeOidc": {
    "Authority": "https://app.example.com",
    "ClientId": "speroflow-knowledge-portal",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "RequireHttpsMetadata": true,
    "DataProtectionKeysDirectory": "/var/lib/speroflow/keys",
    "DataProtectionCertificatePath": "/run/secrets/knowledge_portal_data_protection_certificate",
    "DataProtectionCertificatePasswordPath": "/run/secrets/knowledge_portal_data_protection_certificate_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
