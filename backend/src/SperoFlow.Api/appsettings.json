{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=speroflow;Username=speroflow_app;Password=change-me"
  },
  "Accounts": {
    "PublicWebOrigin": "https://app.example.com",
    "RequireConfirmedEmail": true,
    "AllowPublicRegistration": false,
    "BootstrapRegistrationTokenPath": "/run/secrets/admin_bootstrap_token"
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SperoFlow",
    "UseSsl": true
  },
  "ObjectStorage": {
    "Endpoint": "object-storage:9000",
    "AccessKey": "change-me",
    "SecretKey": "change-me",
    "BucketName": "speroflow-documents",
    "UseSsl": false
  },
  "Redis": {
    "ConnectionString": "redis:6379,abortConnect=false",
    "AiJobsStream": "speroflow:ai:jobs"
  },
  "LegacyKnowledgeIngestion": {
    "Enabled": false
  },
  "AiService": {
    "BaseUrl": "http://ai-api:8000"
  },
  "ServiceJwt": {
    "Issuer": "speroflow-api",
    "KeyId": "speroflow-service-1",
    "PrivateKeyPath": "/run/secrets/service_jwt_private_key",
    "PublicKeyPath": "/run/secrets/service_jwt_public_key",
    "AiAudience": "speroflow-ai",
    "ApiAudience": "speroflow-api"
  },
  "IdentityServer": {
    "Enabled": false,
    "Issuer": "https://app.example.com",
    "KnowledgePortalClientId": "speroflow-knowledge-portal",
    "KnowledgePortalRedirectUri": "https://knowledge.example.com/signin-oidc",
    "SigningCertificatePath": "/run/secrets/oidc_signing_certificate",
    "SigningCertificatePasswordPath": "/run/secrets/oidc_signing_certificate_password",
    "EncryptionCertificatePath": "/run/secrets/oidc_encryption_certificate",
    "EncryptionCertificatePasswordPath": "/run/secrets/oidc_encryption_certificate_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
