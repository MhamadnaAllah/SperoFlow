# SperoFlow frontend environment
#
# Browser requests always use same-origin /api/v1 through Caddy. Do not add
# NEXT_PUBLIC API URLs, external-service variables, database credentials, AI keys, or
# bearer-token settings to the web container.
#
# This is server-only and is used by the Next.js dashboard guard to validate
# the ASP.NET Identity cookie. In Docker Compose it resolves on the private
# network; local development can override it with http://localhost:8080.
API_INTERNAL_BASE_URL=http://api:8080